<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <!-- 开启下划线自动转驼峰 -->
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
    </settings>

    <typeAliases>
        <typeAlias type="com.manage.entity.Admin" alias="Admin"/>
        <typeAlias type="com.manage.entity.Student" alias="Student"/>
        <typeAlias type="com.manage.entity.Score" alias="Score"/>
    </typeAliases>
</configuration>